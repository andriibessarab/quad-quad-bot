<?xml version="1.0" ?>
<!--
  Measurement world for quad-quad-bot walking evaluation.

  Robot dimensions (from locomotion_params.yaml + robot.urdf.xacro):
    Body footprint (hip-to-hip): 165.6 mm (front-back) × 171.6 mm (left-right)
    Standing height:  ~111.5 mm  (home_z=−0.14 − leg_z=0.0285)
    Hip offset  l1:    29.8 mm
    Femur       l2:    96.1 mm
    Tibia       l3:    97.5 mm
    Max reach (l2+l3): 193.6 mm

  Gait (trot):
    Step length:      50 mm  → each 0.25 m tile = exactly 5 steps
    Foot lift:        35 mm
    Cycle period:    0.40 s  (swing 0.15 + stance 0.25)
    Expected speed: ~0.125 m/s  →  1 m ≈ 8 s,  5 m ≈ 40 s

  Robot walks in the −X world direction.
  Runway: x ∈ [−6, +0.5],  y ∈ [−1, +1].

  Scale features:
    - 0.25 m checkerboard (mid-grey on near-black ground)
    - Start line at x=0
    - Speed reference bar: 0.125 m = 1 s of walking (x=0 → x=−0.125)
    - Coloured floor bands at −1 m … −5 m (red→orange→yellow→green→cyan)
    - Matching coloured posts at y=±0.50 m (off centre — clear of robot path)
    - Body footprint slab (magenta) at x=0, y=1.4 m: 165.6 × 171.6 mm
    - Lateral drift lines at y=±0.172 m (robot full foot-spread)
-->
<sdf version="1.8">
  <world name="reference_grid">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>

    <!-- Sun — slightly dimmed to keep the dark theme readable -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ─── Ground plane (near-black) ───────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ─── Checkerboard: mid-grey tiles on dark ground ──────────────────
         Runway x ∈ [−6, +0.5],  y ∈ [−1, +1].  0.25 m tiles = 5 steps each. -->
    <model name="tile_0"><static>true</static><pose>-5.8750 -0.6250 0.001 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.25 0.25 0.002</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual></link></model>
    <model name="tile_1"><static>true</static><pose>-5.8750 -0.1250 0.001 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.25 0.25 0.002</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual></link></model>
    <model name="tile_2"><static>true</static><pose>-5.8750 0.3750 0.001 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.25 0.25 0.002</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual></link></model>
