    <!-- ─── Start line (x=0) ─────────────────────────────────────────────
         White band — robot spawns here and walks in −X direction. -->
    <model name="start_line">
      <static>true</static>
      <pose>0.0 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><box><size>0.030 2.0 0.008</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual></link>
    </model>

    <!-- ─── Speed reference bar ──────────────────────────────────────────
         0.125 m long = exactly 1 second of walking at nominal 0.125 m/s.
         Centred at x=−0.0625, placed at y=+0.35 m (clear of robot). -->
    <model name="speed_ref_1s">
      <static>true</static>
      <pose>-0.0625 0.35 0.005 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><box><size>0.125 0.020 0.008</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual></link>
    </model>

