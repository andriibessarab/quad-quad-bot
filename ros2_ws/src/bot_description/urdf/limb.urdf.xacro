<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="limb">
    <!-- Joint limits loaded from YAML -->
    <xacro:property name="limits"
                    value="${xacro.load_yaml('$(find bot_description)/config/joint_limits.yaml')}"/>

    <!-- Internal limb geometry + internal joints (hfe/kfe). -->
    <xacro:macro name="_limb_core" params="prefix mult">
        <!-- Links -->
        <link name="${prefix}shoulder_link">
            <inertial>
                <origin xyz="0.00123926352361432 0.00335245027216135 0.020963936804564" rpy="0 0 0" />
                <mass value="0.0703942212311305" />
                <inertia ixx="2.76576288052366E-05" ixy="-1.39471839648609E-07" ixz="-2.88488463706858E-07"
                         iyy="1.71370747114446E-05" iyz="-6.19746545161347E-08" izz="2.60685249875832E-05" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://bot_description/meshes/shoulder_link.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://bot_description/meshes/shoulder_link.STL" scale="1 1 1"/>
                </geometry>
            </collision>
        </link>
        <link name="${prefix}femur_link">
            <inertial>
                <origin xyz="0.0219749723740116 1.10674379296058E-05 0.0317318417810033" rpy="0 0 0" />
                <mass value="0.0578650759594537" />
                <inertia ixx="7.21606846133888E-06" ixy="-2.43047276138592E-09" ixz="-8.71808476080296E-07"
                         iyy="3.86361231869082E-05" iyz="-9.13958901614113E-10" izz="3.73315278091681E-05" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://bot_description/meshes/femur_link.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.96078431372549 0.96078431372549 0.964705882352941 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://bot_description/meshes/femur_link.STL" />
                </geometry>
            </collision>
        </link>
        <link name="${prefix}tibia_link">
            <inertial>
                <origin xyz="0.031878867699759 5.86889321863016E-11 1.81508030133726E-08" rpy="0 0 0" />
                <mass value="0.0109091234821787" />
                <inertia ixx="1.95526217620308E-07" ixy="1.4570117043835E-11" ixz="1.85497777908555E-11"
                         iyy="1.01874475115624E-05" iyz="-4.19910780669847E-12" izz="1.01972686884836E-05" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://bot_description/meshes/tibia_link.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.545098039215686 0.615686274509804 0.858823529411765 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://bot_description/meshes/tibia_link.STL" scale="1 1 1"/>
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}hfe_joint" type="revolute">
            <origin xyz="0.02088 0 0.0165" rpy="1.5708 ${0.0 if mult > 0 else 3.1416} 1.5708"/>
            <parent link="${prefix}shoulder_link"/>
            <child link="${prefix}femur_link"/>
            <axis xyz="0 0 ${mult * 1}"/>
            <limit lower="${limits['hfe']['lower']}"
                   upper="${limits['hfe']['upper']}"
                   effort="${limits['hfe']['effort']}"
                   velocity="${limits['hfe']['velocity']}"/>
        </joint>

        <joint name="${prefix}kfe_joint" type="revolute">
            <origin xyz="0.046 0 0.0106" rpy="0 0 0"/>
            <parent link="${prefix}femur_link"/>
            <child link="${prefix}tibia_link"/>
            <axis xyz="0 0 ${mult * -1}"/>
            <limit lower="${limits['kfe']['lower']}"
                   upper="${limits['kfe']['upper']}"
                   effort="${limits['kfe']['effort']}"
                   velocity="${limits['kfe']['velocity']}"/>
        </joint>
    </xacro:macro>

    <!-- Public limb macro: owns full attachment to body, hiding internal limb construction. -->
    <xacro:macro name="limb" params="prefix x y z r p yw mult parent_link:=body_link">
        <xacro:_limb_core prefix="${prefix}_" mult="${mult}"/>
        <joint name="${prefix}_haa_joint" type="revolute">
            <parent link="${parent_link}"/>
            <child link="${prefix}_shoulder_link"/>
            <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yw}"/>
            <axis xyz="0 0 ${mult * -1}"/>
            <limit lower="${limits['haa']['lower']}"
                   upper="${limits['haa']['upper']}"
                   effort="${limits['haa']['effort']}"
                   velocity="${limits['haa']['velocity']}"/>
        </joint>
    </xacro:macro>
</robot>
